[Unit]
Description=OSGARD browser live relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/osgard/live-relay.env
ExecStart=/opt/osgard/live-relay/mediamtx /etc/osgard/live-relay/mediamtx.yml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/osgard/live-relay

[Install]
WantedBy=multi-user.target
