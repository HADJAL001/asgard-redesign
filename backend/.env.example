# === Сервер ===
PORT=3002
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
# DB_PATH — путь к файлу SQLite (better-sqlite3). На Railway подключите Volume
# с mount path /data и задайте DB_PATH=/data/osgard.db, иначе очередь и память
# платформы пересоздадутся пустыми при каждом redeploy/restart.
DB_PATH=./data/osgard.db

# === JWT ===
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=7d

# === Соц-логин (OAuth 2.0 + PKCE) ===
# BACKEND_PUBLIC_URL — публичный адрес ЭТОГО бэкенда, используется для
# построения redirect_uri. Тот же адрес нужно зарегистрировать в консоли
# каждого провайдера как redirect URI: ${BACKEND_PUBLIC_URL}/auth/<provider>/callback
BACKEND_PUBLIC_URL=http://localhost:3002
# FRONTEND_URL — куда бэкенд редиректит после успешного/неуспешного OAuth
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# === Прочее (уже использующиеся в проекте) ===
ENCRYPTION_KEY=
# REDIS_URL — необязателен. Если не задан, cache.service.ts работает на
# in-memory кеше. Формат — обычная TCP-строка подключения, например Upstash
# "Redis" (не REST) endpoint: redis://default:<password>@<host>:<port>
# или rediss://... для TLS.
REDIS_URL=

# === Stripe (подписки) ===
# STRIPE_SECRET_KEY — sk_test_... в dev/sandbox, sk_live_... в боевом режиме.
# Если не задан — subscription.routes.ts/addons.routes.ts работают в mock-режиме
# (подписка активируется в БД без обращения к Stripe; в NODE_ENV=production запрещено).
STRIPE_SECRET_KEY=
# Webhook endpoint /subscription/webhook — секрет ИМЕННО этого endpoint-а из Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=
# Webhook endpoint /addons/webhook — это ОТДЕЛЬНЫЙ URL в Stripe Dashboard со своим секретом,
# отличным от STRIPE_WEBHOOK_SECRET выше. Если не задан — addons.routes.ts фолбэкается на
# STRIPE_WEBHOOK_SECRET (сработает только если оба webhook-а в Stripe используют один секрет,
# что Stripe не позволяет для двух разных зарегистрированных endpoint-ов).
STRIPE_WEBHOOK_SECRET_ADDONS=
# Price ID тарифов подписки (Stripe Dashboard → Product catalog), см. PlanKey в lib/stripe.ts
STRIPE_PRICE_PRO=
STRIPE_PRICE_SUPREME=
STRIPE_PRICE_DUO=
STRIPE_PRICE_ELITE=
# Price ID addon-подписок ДЖАРВИС/ВАЛЛИ Premium ($99/мес каждая), см. lib/addons.ts
STRIPE_PRICE_JARVIS_PREMIUM=
STRIPE_PRICE_WALLI_PREMIUM=

# ── OSGARD Founders Program (Академия/сертификация) — см. lib/academy.ts ──────
# Продукт выключен по умолчанию: ACADEMY_ENABLED != "true" → checkout отдаёт 503,
# витрина на фронте скрыта, поведение прода не меняется. Включать только когда
# заведены Price ID и webhook-endpoint в Stripe.
ACADEMY_ENABLED=
# Price ID тиров лестницы (Stripe Dashboard → Product catalog): founder_track ($99/мес),
# founder_circle ($990/мес — включает слот встречи с создателями).
STRIPE_PRICE_FOUNDER_TRACK=
STRIPE_PRICE_FOUNDER_CIRCLE=
# ОТДЕЛЬНЫЙ webhook endpoint /academy/webhook со своим секретом. Если не задан —
# academy.routes.ts фолбэкается на STRIPE_WEBHOOK_SECRET (как и addons).
STRIPE_WEBHOOK_SECRET_ACADEMY=

# ─── ЮKassa (YooKassa) — оплата подписки из России ──────────────────────────
# Оплата картами РФ (Мир/Visa/MC), СБП, SberPay. Параллельный Stripe провайдер.
# Если ключи не заданы — POST /yookassa/create-payment отдаёт 503 (как Stripe
# без ключей), кнопка «Оплатить из России» на /pricing не активна. См.
# docs/yookassa-setup.md для пошаговой настройки.
#
# shopId магазина (тестовый или боевой) из ЛК ЮKassa → Настройки → Магазин.
YOOKASSA_SHOP_ID=
# Секретный ключ API. Тестовый начинается с test_..., боевой с live_...
YOOKASSA_SECRET_KEY=
# (необязательно) Переопределение рублёвых цен планов, ₽/мес. По умолчанию:
# pro 2900, supreme 9900, duo 14900, elite 19900.
YOOKASSA_PRICE_PRO=
YOOKASSA_PRICE_SUPREME=
YOOKASSA_PRICE_DUO=
YOOKASSA_PRICE_ELITE=
# Ставка НДС для чека 54-ФЗ (боевой режим с онлайн-кассой). 1 = без НДС
# (самозанятые/УСН, по умолчанию), 2 = 0%, 3 = 10%, 4 = 20%, 5/6 = расч. 10/110, 20/120.
YOOKASSA_VAT_CODE=1

# === Solana / TimeCoin (казначейство) ===
SOLANA_RPC_URL=
# TREASURY_SECRET_KEY — JSON-массив байт секретного ключа казначейства
TREASURY_SECRET_KEY=
TC_MINT_ADDRESS=

# === AI-провайдеры генерации проектов ===
# Планировщик и независимый ревьюер: Claude, затем Kimi. Автор кода: только DeepSeek.
CLAUDE_API_KEY=
# CLAUDE_API_URL — необязателен, для проксирования запросов к Anthropic через сторонний шлюз
CLAUDE_API_URL=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_REASONING_MODEL=claude-opus-4.7
KIMI_API_KEY=
KIMI_API_URL=https://api.moonshot.ai/v1/chat/completions
KIMI_MODEL=kimi-k2.5
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
# Жёсткий дедлайн одного запроса к провайдеру (10–300 секунд).
AI_PROVIDER_TIMEOUT_MS=90000
# В production ревью Claude/Kimi обязательно. Для аварийного режима можно явно поставить 0.
OSGARD_REQUIRE_AI_REVIEW=1
GROK_API_KEY=
GROK_MODEL=grok-4-fast

# === Голос ДЖАРВИС/ВАЛЛИ (ElevenLabs TTS, 5 стилей) ===
# Без ключа /jarvis/speak возвращает 503, фронт делает fallback на браузерный TTS
ELEVENLABS_API_KEY=

# === Деплой сгенерированных приложений (Netlify, единый серверный токен) ===
NETLIFY_AUTH_TOKEN=

# === Деплой сгенерированных приложений (Vercel, единый серверный токен) ===
VERCEL_TOKEN=
# VERCEL_TEAM_ID — необязателен, нужен только если токен привязан к команде
VERCEL_TEAM_ID=

# === Публикация сгенерированных приложений в GitHub ===
# Personal Access Token с правом repo — НЕ путать с GITHUB_CLIENT_ID/SECRET
# выше (это OAuth-приложение для соц-логина пользователей)
GITHUB_TOKEN=

# === Обратная связь (feedback.routes.ts) — Telegram и/или Email, оба необязательны ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FEEDBACK_TO_EMAIL=

# === Бэкпрешер очереди записи (write-backpressure.ts) — необязательны, есть дефолты ===
WRITE_QUEUE_MAX_CONCURRENT=20
WRITE_QUEUE_MAX_DEPTH=300

# === База данных для сгенерированных приложений (app-database.service.ts) ===
# APPS_DATABASE_URL — строка подключения к кластеру Postgres, в котором каждому
# fullstack-приложению выдаётся СВОЯ схема и СВОЯ роль. Роль в этой строке должна
# иметь право создавать схемы и роли (CREATEROLE), поэтому это админский доступ
# к кластеру приложений и НИЧЕГО больше: платформенный sqlite тут не при чём.
#
# Пока переменная не задана, провижининг честно отвечает «кластер не подключён»:
# fullstack-приложения продолжают генерироваться и собираться, но базу не получают
# (в отчёте генерации это видно как status=not-configured, а не как успех).
#
# Выданные строки подключения хранятся ЗАШИФРОВАННЫМИ (ENCRYPTION_KEY) в таблице
# app_databases и в файлы приложения не попадают — владелец забирает их запросом
# GET /projects/:id/database. Проверка изоляции: npx tsx scripts/verify-app-db-isolation.ts
APPS_DATABASE_URL=
